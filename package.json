{
  "name": "satisfactory-server-manager",
  "productName": "Satisfactory Server Manager",
  "version": "1.0.0",
  "description": "Desktop manager for Satisfactory dedicated servers on Windows: installation, monitoring, backups, mods, scheduling and secure remote management.",
  "main": "src/main/main.js",
  "author": "SuperSeller100X",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "homepage": "https://github.com/SuperSeller100X/SatisfactoryServerManager",
  "repository": {
    "type": "git",
    "url": "https://github.com/SuperSeller100X/SatisfactoryServerManager.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 \"test/unit/*.test.js\"",
    "lint": "node scripts/check-syntax.js",
    "dist:win": "electron-builder --win --x64",
    "dist:dir": "electron-builder --win --x64 --dir",
    "assets": "node scripts/build-assets.js",
    "test:e2e": "node test/e2e/run-e2e.js && node test/e2e/pages-smoke.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "electron": "44.11.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.superseller100x.satisfactoryservermanager",
    "productName": "Satisfactory Server Manager",
    "copyright": "Copyright (c) 2026 SuperSeller100X",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "SatisfactoryServerManager-${version}-${arch}.${ext}",
      "legalTrademarks": "Satisfactory is a trademark of Coffee Stain Studios AB."
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "selectPerMachineByDefault": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "Satisfactory Server Manager",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh",
      "artifactName": "SatisfactoryServerManager-Setup-${version}.${ext}",
      "uninstallDisplayName": "Satisfactory Server Manager",
      "menuCategory": false,
      "warningsAsErrors": true
    }
  }
}
